<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_liquid_glass" model="ir.ui.view">
        <field name="name">res.users.preferences.form.liquid_glass</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="liquid_glass_mode" widget="radio" options="{'horizontal': true}" readonly="0"/>
                <field name="liquid_glass_scheme" widget="liquid_glass_scheme" options="{'horizontal': true}" readonly="0"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_liquid_glass" model="ir.ui.view">
        <field name="name">res.users.form.liquid_glass</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="liquid_glass_mode" widget="radio" options="{'horizontal': true}" invisible="share"/>
                <field name="liquid_glass_scheme" widget="liquid_glass_scheme" options="{'horizontal': true}" invisible="share"/>
            </xpath>
        </field>
    </record>

    <!-- The preferences are body classes rendered server-side: no flash before JS runs -->
    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//t[@t-set='body_classname']" position="attributes">
            <attribute name="t-value">request.env.user._liquid_glass_body_classes()</attribute>
        </xpath>
    </template>
</odoo>
